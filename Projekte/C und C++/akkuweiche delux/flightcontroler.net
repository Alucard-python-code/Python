    (comp (ref J32) (value "Servo_32") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical") (tstamp 5F030032))

    ;; Die 6 S.BUS-Hauptausgangsstecker
    (comp (ref J33) (value "SBUS_Out_1") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical") (tstamp 5F040001))
    (comp (ref J34) (value "SBUS_Out_2") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical") (tstamp 5F040002))
    (comp (ref J35) (value "SBUS_Out_3") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical") (tstamp 5F040003))
    (comp (ref J36) (value "SBUS_Out_4") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical") (tstamp 5F040004))
    (comp (ref J37) (value "SBUS_Out_5") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical") (tstamp 5F040005))
    (comp (ref J38) (value "SBUS_Out_6") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical") (tstamp 5F040006)))
  (nets
    ;; Globales System-GND & Rolle-Strapping
    (net (code 1) (name "GND")
      (node (ref U1) (pin 57)) (node (ref U2) (pin 57))
      (node (ref U3) (pin 8))  (node (ref U4) (pin 8))  (node (ref U5) (pin 8))  (node (ref U6) (pin 8))
      (node (ref U7) (pin 8))  (node (ref U8) (pin 8))  (node (ref U9) (pin 8))  (node (ref U10) (pin 8))
      (node (ref U11) (pin 8)) (node (ref U12) (pin 8))
      (node (ref J1) (pin 1))  (node (ref J2) (pin 1))  (node (ref J3) (pin 1))  (node (ref J32) (pin 1))
      (node (ref U1) (pin 22))) ;; Hardware Strapping: PIN 22 an Master liegt fest auf Masse

    (net (code 2) (name "VCC_SERVO")
      (node (ref J1) (pin 2))  (node (ref J2) (pin 2))  (node (ref J3) (pin 2))  (node (ref J32) (pin 2))
      (node (ref J33) (pin 2)) (node (ref J38) (pin 2)))

    ;; Unbestechliche Hardware-Watchdog-Weiche (Select & Enable Leitungen parallel)
    (net (code 3) (name "WATCHDOG_SELECT")
      (node (ref U1) (pin 50)) ;; GPIO 47 an Master erzeugt das Frequenzsignal
      (node (ref U3) (pin 1))  (node (ref U4) (pin 1))  (node (ref U5) (pin 1))  (node (ref U6) (pin 1))
      (node (ref U7) (pin 1))  (node (ref U8) (pin 1))  (node (ref U9) (pin 1))  (node (ref U10) (pin 1))
      (node (ref U11) (pin 1)) (node (ref U12) (pin 1))
      (node (ref U3) (pin 15)) (node (ref U4) (pin 15)) (node (ref U5) (pin 15)) (node (ref U6) (15))
      (node (ref U7) (pin 15)) (node (ref U8) (pin 15)) (node (ref U9) (pin 15)) (node (ref U10) (pin 15))
      (node (ref U11) (pin 15)) (node (ref U12) (pin 15)))

    ;; Kreuzkopplung & Kerosinsensor
    (net (code 4) (name "RS485_INTERN_A")
      (node (ref U1) (pin 12))   ;; UART1 Tx Master
      (node (ref U2) (pin 13)))  ;; UART1 Rx Backup
    (net (code 5) (name "RS485_INTERN_B")
      (node (ref U1) (pin 13))   ;; UART1 Rx Master
      (node (ref U2) (pin 12)))  ;; UART1 Tx Backup

    (net (code 6) (name "FLOW_SENSOR_SIGNAL")
      (node (ref U1) (pin 49))   ;; GPIO 46 Master
      (node (ref U2) (pin 49)))  ;; GPIO 46 Backup (Hot-Standby)
    ;; --- BLOCK U3: Servos 1 bis 4 ---
    (net (code 7) (name "M_PWM_0") (node (ref U1) (pin 2)) (node (ref U3) (pin 2)))
    (net (code 8) (name "B_PWM_0") (node (ref U2) (pin 2)) (node (ref U3) (pin 3)))
    (net (code 9) (name "OUT_PWM_0") (node (ref U3) (pin 4)) (node (ref J1) (pin 3)))

    (net (code 10) (name "M_PWM_1") (node (ref U1) (pin 3)) (node (ref U3) (pin 5)))
    (net (code 11) (name "B_PWM_1") (node (ref U2) (pin 3)) (node (ref U3) (pin 6)))
    (net (code 12) (name "OUT_PWM_1") (node (ref U3) (pin 7)) (node (ref J2) (pin 3)))

    (net (code 13) (name "M_PWM_2") (node (ref U1) (pin 4)) (node (ref U3) (pin 11)))
    (net (code 14) (name "B_PWM_2") (node (ref U2) (pin 4)) (node (ref U3) (pin 10)))
    (net (code 15) (name "OUT_PWM_2") (node (ref U3) (pin 9)) (node (ref J3) (pin 3)))

    (net (code 16) (name "M_PWM_3") (node (ref U1) (pin 5)) (node (ref U3) (pin 14)))
    (net (code 17) (name "B_PWM_3") (node (ref U2) (pin 5)) (node (ref U3) (pin 13)))
    (net (code 18) (name "OUT_PWM_3") (node (ref U3) (pin 12)) (node (ref J4) (pin 3)))

    ;; --- BLOCK U4: Servos 5 bis 8 ---
    (net (code 19) (name "M_PWM_4") (node (ref U1) (pin 6)) (node (ref U4) (pin 2)))
    (net (code 20) (name "B_PWM_4") (node (ref U2) (pin 6)) (node (ref U4) (pin 3)))
    (net (code 21) (name "OUT_PWM_4") (node (ref U4) (pin 4)) (node (ref J5) (pin 3)))

    (net (code 22) (name "M_PWM_5") (node (ref U1) (pin 7)) (node (ref U4) (pin 5)))
    (net (code 23) (name "B_PWM_5") (node (ref U2) (pin 7)) (node (ref U4) (pin 6)))
    (net (code 24) (name "OUT_PWM_5") (node (ref U4) (pin 7)) (node (ref J6) (pin 3)))

    ;; --- DYNAMISCHER END-STRANG (Servo 32 & S.BUS) ---
    (net (code 25) (name "M_PWM_31") (node (ref U1) (pin 35)) (node (ref U10) (pin 14)))
    (net (code 26) (name "B_PWM_31") (node (ref U2) (pin 35)) (node (ref U10) (pin 13)))
    (net (code 27) (name "OUT_PWM_31") (node (ref U10) (pin 12)) (node (ref J32) (pin 3)))

    (net (code 28) (name "M_SBUS_0") (node (ref U1) (pin 36)) (node (ref U11) (pin 2)))
    (net (code 29) (name "B_SBUS_0") (node (ref U2) (pin 36)) (node (ref U11) (pin 3)))
    (net (code 30) (name "OUT_SBUS_1") (node (ref U11) (pin 4)) (node (ref J33) (pin 3)))

    (net (code 31) (name "M_SBUS_5") (node (ref U1) (pin 41)) (node (ref U12) (pin 14)))
    (net (code 32) (name "B_SBUS_5") (node (ref U2) (pin 41)) (node (ref U12) (pin 13)))
    (net (code 33) (name "OUT_SBUS_6") (node (ref U12) (pin 12)) (node (ref J38) (pin 3)))
))
