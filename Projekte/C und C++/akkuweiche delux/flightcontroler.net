    (comp (ref J10) (value "Servo_10") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical") (tstamp 5F030010))
    (comp (ref J11) (value "Servo_11") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical") (tstamp 5F030011))
