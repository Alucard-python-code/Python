    (comp (ref U9) (value "74CBTLV3257") (footprint "Package_SO:TSSOP-16_4.4x5mm_P0.65mm") (tstamp 5F020009))
    (comp (ref U10) (value "74CBTLV3257") (footprint "Package_SO:TSSOP-16_4.4x5mm_P0.65mm") (tstamp 5F020010))

    ;; 2x Multiplexer fuer die 6 S.BUS-Ausgaenge
    (comp (ref U11) (value "74CBTLV3257") (footprint "Package_SO:TSSOP-16_4.4x5mm_P0.65mm") (tstamp 5F020011))
    (comp (ref U12) (value "74CBTLV3257") (footprint "Package_SO:TSSOP-16_4.4x5mm_P0.65mm") (tstamp 5F020012))
    ;; Physische 3-Pin Ausgangs-Stiftleisten zu den Rudern (Masse, Plus, Signal)
    (comp (ref J1) (value "Servo_1") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical") (tstamp 5F030001))
    (comp (ref J2) (value "Servo_2") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical") (tstamp 5F030002))
    (comp (ref J3) (value "Servo_3") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical") (tstamp 5F030003))
    (comp (ref J4) (value "Servo_4") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical") (tstamp 5F030004))
    (comp (ref J5) (value "Servo_5") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical") (tstamp 5F030005))
    (comp (ref J6) (value "Servo_6") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical") (tstamp 5F030006))
    (comp (ref J7) (value "Servo_7") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical") (tstamp 5F030007))
    (comp (ref J8) (value "Servo_8") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical") (tstamp 5F030008))
