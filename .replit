modules = ["bash", "python-3.11"]

[nix]
channel = "stable-25_05"
packages = ["libglvnd", "xorg.libxcb", "xorg.libX11", "xorg.xcbutil", "xorg.xcbutilimage", "xorg.xcbutilkeysyms", "xorg.xcbutilrenderutil", "xorg.xcbutilwm", "xorg.libXext", "libxkbcommon", "glib", "dbus", "fontconfig", "freetype", "novnc", "tigervnc"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "PyHART Web Preview"

[[workflows.workflow]]
name = "PyHART Web Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash run_pyhart_web.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
