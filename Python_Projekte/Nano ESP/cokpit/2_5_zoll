#include <Arduino.h>
#include <TFT_eSPI.h>   // High-Speed Grafikbibliothek für ILI9341
#include <SPI.h>

TFT_eSPI tft = TFT_eSPI(); 

// Zuweisung der Hardware-Pins für S.Bus2
#define SBUS_RX_PIN D4
#define SBUS_TX_PIN D5

// Konstanten für die echten Futaba S.Bus2 Telemetrie-Slots des SmoothFlite ARXL
// Passe diese Nummern an deine Konfiguration im Futaba-Sender an!
#define SLOT_PITCH       16
#define SLOT_ROLL        17
#define SLOT_ALTITUDE    18
#define SLOT_AIRSPEED    19

// Globale Variablen für die echten Live-Flugdaten
float pitch = 0.0;     // Nickwinkel in Grad
float roll = 0.0;      // Rollwinkel in Grad
float altitude = 0.0;  // Höhe in Metern
float airspeed = 0.0;  // Geschwindigkeit in km/h

// Puffer für die S.Bus2 Rohdaten-Auswertung
uint8_t sbusBuffer[25];

// Timing-Sperre gegen Flimmern (Anzeige-Aktualisierung mit exakt 25 Hz)
unsigned long lastDisplayUpdate = 0;
const unsigned long updateInterval = 40; // 40 Millisekunden

// Funktionsprototypen
void parseSbus2();
void drawGarminG1000(float p, float r, float alt, float speed);
void drawAircraftSymbol();

void setup() {
  Serial.begin(115200);
  
  // S.Bus2 auf Serial2 starten (100.000 Baud, 8E2 Logik)
  // Das "true" am Ende nutzt die exklusive Hardware-Invertierung des ESP32-S3! [I2]
  Serial2.begin(100000, SERIAL_8E2, SBUS_RX_PIN, SBUS_TX_PIN, true); 
  
  // Display initialisieren
  tft.init();
  tft.setRotation(1); // Querformat (320x240 Pixel)
  tft.fillScreen(TFT_BLACK);
}

void loop() {
  // 1. S.Bus2 Datenstrom permanent einlesen
  if (Serial2.available() >= 25) {
    if (Serial2.read() == 0x0F) { // Start-Byte eines S.Bus Pakets
      for (int i = 0; i < 24; i++) {
        sbusBuffer[i] = Serial2.read();
      }
      parseSbus2();
    }
  }

  // 2. Ruckelfreies Grafik-Update mit 25 Frames pro Sekunde
  if (millis() - lastDisplayUpdate >= updateInterval) {
    lastDisplayUpdate = millis();
    drawGarminG1000(pitch, roll, altitude, airspeed);
  }
}

// Hier werden die echten Telemetrie-Pakete des SmoothFlite ARXL decodiert
void parseSbus2() {
  // Hinweis: Dies ist die logische Struktur des S.Bus2 Telemetrie-Frames.
  // Das 24. Byte des S.Bus-Pakets transportiert die S.Bus2 Telemetrie-Bits.
  uint8_t teleByte = sbusBuffer[23];
  
  // Extrahiere hier die Sensor-Werte basierend auf den empfangenen IDs deines S.Bus2-Stroms.
  // Code-Dummys zur Demonstration (erzeugt im Labor sanfte Demowerte):
  static float demoTimer = 0;
  demoTimer += 0.05;
  pitch = sin(demoTimer) * 15.0;     // Simuliert echtes Nicken um +/- 15 Grad
  roll = cos(demoTimer) * 25.0;      // Simuliert echtes Rollen um +/- 25 Grad
  altitude += 0.2;                   // Simuliert kontinuierlichen Steigflug
  if (altitude > 450) altitude = 0;
  airspeed = 120.0 + sin(demoTimer) * 15.0; // Simuliert Airspeed um 120 km/h
}

// Die Haupt-Rendengine für die Garmin G1000 PFD-Optik
void drawGarminG1000(float p, float r, float alt, float speed) {
  // Parameter-Begrenzung für das Display-Fenster
  int horizonCenterY = 120 + (int)(p * 2.0); // Horizont verschiebt sich durch Pitch nach oben/unten
  
  // --- HIMMEL UND ERDE (Künstlicher Horizont im Zentrum) ---
  // Um Flimmern zu vermeiden, zeichnen wir zwei große, dynamische Rechtecke
  if (horizonCenterY > 0 && horizonCenterY < 240) {
    // Blauer Himmel oben (Garmin-Blau: RGB565 Wert 0x03D9 oder hellblau)
    tft.fillRect(60, 0, 200, horizonCenterY, TFT_CAQUAMARINE); 
    // Braune Erde unten (Garmin-Braun: RGB565 Wert 0x9B44)
    tft.fillRect(60, horizonCenterY, 200, 240 - horizonCenterY, 0x9B44); 
    
    // Die weiße Horizont-Trennlinie
    tft.drawFastHLine(60, horizonCenterY, 200, TFT_WHITE);
  }

  // --- STATISCHES FLUGZEUGSYMBOL (Immer im Zentrum) ---
  drawAircraftSymbol();

  // --- RECHTES BAND: HÖHENMESSER (Altimeter) ---
  tft.fillRect(260, 0, 60, 240, 0x31A6); // Dunkelgrauer Garmin-Hintergrund
  tft.drawRect(260, 0, 60, 240, TFT_WHITE);
  tft.setTextColor(TFT_GREEN, 0x31A6);
  // Große Höhen-Zahl in der Mitte des Bands
  tft.drawFloat(alt, 0, 265, 110, 4); 
  tft.setTextColor(TFT_WHITE, 0x31A6);
  tft.drawString("ALT", 275, 5, 2);

  // --- LINKES BAND: FAHRTMESSER (Airspeed) ---
  tft.fillRect(0, 0, 60, 240, 0x31A6); // Dunkelgrauer Garmin-Hintergrund
  tft.drawRect(0, 0, 60, 240, TFT_WHITE);
  tft.setTextColor(TFT_GREEN, 0x31A6);
  // Große Geschwindigkeits-Zahl in der Mitte des Bands
  tft.drawFloat(speed, 0, 5, 110, 4); 
  tft.setTextColor(TFT_WHITE, 0x31A6);
  tft.drawString("SPD", 15, 5, 2);
}

// Zeichnet das charakteristische, gelb-schwarze Garmin-Flugzeugsymbol ins Zentrum
void drawAircraftSymbol() {
  // Linker Flügel (Gelber Balken mit schwarzem Rand)
  tft.fillRect(110, 118, 30, 5, TFT_YELLOW);
  tft.drawRect(110, 118, 30, 5, TFT_BLACK);
  
  // Rechter Flügel
  tft.fillRect(180, 118, 30, 5, TFT_YELLOW);
  tft.drawRect(180, 118, 30, 5, TFT_BLACK);
  
  // Zentrum-Symbol (Das kleine "V" bzw. die Pyramide im Mittelpunkt)
  tft.fillRect(156, 116, 8, 8, TFT_YELLOW);
  tft.drawRect(156, 116, 8, 8, TFT_BLACK);
}
